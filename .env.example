# Copiar los valores reales únicamente al entorno del proceso o a Render.
# npm start no carga este archivo automáticamente.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Exclusivamente para Node.js o Docker locales. Dejar vacíos en Render.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=una-chat
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
LAB_RUN_ID=lab07-local

# Solo backend de Lab08. Nunca usar prefijo VITE_ para estas variables.
# Usar el rol una_chat_backend y sslmode=verify-full.
VAULT_DATABASE_URL=
# Ruta al certificado CA descargado desde Supabase, si se necesita.
VAULT_CA_FILE=

# Identificadores públicos del backend (también definidos en auth0.config.json).
AUTH0_DOMAIN=dev-pf35xfcx4ef71iio.us.auth0.com
AUTH0_CLIENT_ID=CHJDFZdQSmeR6oqgsnVKkNrr02mn7VXJ
AUTH0_AUDIENCE=https://una-chat-lab08/api
